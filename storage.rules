rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /patients/{patientId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == patientId;
    }
    match /prescriptionUploads/{patientId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == patientId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
