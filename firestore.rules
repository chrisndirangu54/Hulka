rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function roleIs(name) {
      return signedIn()
        && userDoc().data.role == name
        && userDoc().data.verified == true;
    }
    function sameUser(uid) { return signedIn() && request.auth.uid == uid; }

    function consentPath(patientId, granteeId) {
      return /databases/$(database)/documents/consents/$(patientId + '_' + granteeId);
    }

    function hasConsent(patientId, scope) {
      let c = get(consentPath(patientId, request.auth.uid));
      return signedIn()
        && c.exists()
        && c.data.patientId == patientId
        && c.data.granteeId == request.auth.uid
        && c.data.revokedAt == null
        && (c.data.expiresAt == null || c.data.expiresAt > request.time)
        && scope in c.data.scopes;
    }

    match /users/{uid} {
      allow read: if sameUser(uid);
      allow create: if sameUser(uid)
        && request.resource.data.role == 'patient'
        && request.resource.data.verified == true;
      allow update: if roleIs('platformAdmin')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'organizationId',
          'verified',
          'displayName',
          'providerVerifiedAt',
          'providerVerifiedBy'
        ]);
      allow update: if sameUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'email',
          'fcmTokens',
          'notificationsUpdatedAt',
          'sokonisLink'
        ])
        && (
          !('sokonisLink' in request.resource.data)
          || request.resource.data.sokonisLink == null
          || (
            request.resource.data.sokonisLink is map
            && request.resource.data.sokonisLink.keys().hasOnly(['uid', 'email', 'linkedAt'])
            && request.resource.data.sokonisLink.uid is string
            && request.resource.data.sokonisLink.uid.size() > 0
            && request.resource.data.sokonisLink.uid.size() < 128
            && request.resource.data.sokonisLink.email is string
            && request.resource.data.sokonisLink.email.size() < 180
            && request.resource.data.sokonisLink.linkedAt is timestamp
          )
        );
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read: if sameUser(patientId) || (signedIn() && hasConsent(patientId, 'patient.profile.read'));
      allow create, update: if sameUser(patientId);
      allow delete: if false;

      match /importRequests/{requestId} {
        allow read: if sameUser(patientId);
        allow create: if sameUser(patientId)
          && request.resource.data.patientId == patientId
          && request.resource.data.sourceSystem == 'TeknTandao Workspace'
          && request.resource.data.status == 'pendingVerification'
          && request.resource.data.consentAcknowledged == true
          && request.resource.data.hospitalName is string
          && request.resource.data.hospitalName.size() > 0
          && request.resource.data.hospitalName.size() <= 180
          && request.resource.data.externalPatientId is string
          && request.resource.data.externalPatientId.size() > 0
          && request.resource.data.externalPatientId.size() <= 120;
        allow update, delete: if false;
      }

      match /timeline/{eventId} {
        allow read: if sameUser(patientId) || (signedIn() && hasConsent(patientId, 'patient.timeline.read'));
        allow create: if (sameUser(patientId)
          && request.resource.data.type in ['patientDocument', 'importedHospitalHistory']
          && request.resource.data.reviewStatus == 'unverified'
          && request.resource.data.provenance in ['patientUpload', 'patientSuppliedExport'])
          || (signedIn() && hasConsent(patientId, 'patient.timeline.write')
          && request.resource.data.type != 'importedHospitalHistory');
        allow update: if false; // Reconciliation uses checked Cloud Function only
        allow delete: if false;
      }

      match /observations/{observationId} {
        allow read: if sameUser(patientId) || (signedIn() && hasConsent(patientId, 'patient.observations.read'));
        allow create: if sameUser(patientId) || (signedIn() && hasConsent(patientId, 'patient.observations.write'));
        allow update, delete: if false;
      }

      match /deviceRaw/{observationId} {
        allow read: if sameUser(patientId);
        allow create: if sameUser(patientId)
          && request.resource.data.synthetic == false
          && request.resource.data.provenance == 'wearable';
        allow update, delete: if false;
      }

      match /dosageReminders/{reminderId} {
        allow read, delete: if sameUser(patientId);
        allow create: if sameUser(patientId)
          && request.resource.data.patientId == patientId
          && request.resource.data.medicine is string
          && request.resource.data.medicine.size() > 0
          && request.resource.data.medicine.size() < 120
          && request.resource.data.times is list
          && request.resource.data.times.size() > 0
          && request.resource.data.times.size() < 12;
        allow update: if sameUser(patientId)
          && request.resource.data.patientId == patientId;
      }

      match /wellnessEntries/{entryId} {
        allow read: if sameUser(patientId)
          || (signedIn() && hasConsent(patientId, 'patient.observations.read'));
        allow create: if sameUser(patientId)
          && request.resource.data.patientId == patientId
          && request.resource.data.synthetic == false
          && request.resource.data.provenance == 'patientReported';
        allow update: if sameUser(patientId)
          && resource.data.patientId == patientId
          && request.resource.data.patientId == patientId
          && request.resource.data.synthetic == false
          && request.resource.data.provenance == 'patientReported';
        allow delete: if sameUser(patientId);
      }
    }

    match /consents/{consentId} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid || resource.data.granteeId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid;
      allow update: if signedIn() && resource.data.patientId == request.auth.uid;
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid || resource.data.clinicianId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.patientId == request.auth.uid || resource.data.clinicianId == request.auth.uid);
      allow delete: if false;
    }

    match /prescriptions/{prescriptionId} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid ||
         resource.data.clinicianId == request.auth.uid ||
         roleIs('pharmacist'));
      allow create, update, delete: if false;
    }

    match /pharmacyInventory/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /dispensingEvents/{eventId} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid ||
         resource.data.pharmacistId == request.auth.uid ||
         roleIs('clinician'));
      allow write: if false;
    }

    match /pharmacyOrders/{orderId} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid ||
         roleIs('pharmacist'));
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'reserved'
        && request.resource.data.inventoryId is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.quantity < 500;
      allow update: if roleIs('pharmacist');
      allow delete: if false;
    }

    match /labResults/{resultId} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid ||
         hasConsent(resource.data.patientId, 'patient.timeline.read'));
      allow write: if false;
    }

    match /emergencyProfiles/{patientId} {
      allow read, create, update: if sameUser(patientId);
      allow delete: if false;
    }

    match /caregiverGrants/{grantId} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid || resource.data.caregiverId == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.patientId == request.auth.uid;
      allow delete: if false;
    }

    match /carePrograms/{programId} {
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid ||
         hasConsent(resource.data.patientId, 'patient.timeline.read'));
      allow write: if false;
    }

    match /insuranceCoverage/{coverageId} {
      allow read: if signedIn() && resource.data.patientId == request.auth.uid;
      allow write: if false;
    }

    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create, update: if roleIs('platformAdmin');
      allow delete: if false;
    }

    match /preventiveTasks/{taskId} {
      allow read: if signedIn() && resource.data.patientId == request.auth.uid;
      allow write: if false;
    }

    match /preventiveRulePacks/{packId} {
      allow read, write: if false;
    }

    match /analyticsAggregates/{metricId} {
      allow read, write: if false;
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    match /adverseEvents/{eventId} {
      allow read, write: if false;
    }

    match /research/{document=**} {
      allow read, write: if false;
    }

    match /clinicianDirectory/{docId} {
      allow read: if signedIn();
      allow create, update: if roleIs('platformAdmin');
      allow delete: if false;
    }

    match /pharmaceuticalProducts/{productId} {
      allow read: if signedIn();
      allow create, update: if roleIs('platformAdmin');
      allow delete: if false;
    }

    match /ambulanceUnits/{unitId} {
      allow read: if signedIn();
      allow create, update: if roleIs('platformAdmin');
      allow delete: if false;
    }

    match /ambulanceRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || roleIs('platformAdmin')
        || roleIs('hospitalAdmin')
        || roleIs('clinician')
      );
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.hospitalName is string
        && request.resource.data.hospitalName.size() > 0
        && request.resource.data.hospitalName.size() < 180
        && request.resource.data.locationNote is string
        && request.resource.data.locationNote.size() < 500;
      allow update: if signedIn() && (
        (resource.data.patientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled')
        || roleIs('platformAdmin')
        || roleIs('hospitalAdmin')
      );
      allow delete: if false;
    }

    match /partnerApplications/{appId} {
      allow read: if signedIn() && (
        resource.data.applicantUid == request.auth.uid || roleIs('platformAdmin')
      );
      allow create: if signedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.organizationName is string
        && request.resource.data.organizationName.size() > 0
        && request.resource.data.organizationName.size() < 180
        && request.resource.data.note is string
        && request.resource.data.note.size() < 2000;
      allow update: if roleIs('platformAdmin');
      allow delete: if false;
    }

    match /prescriptionUploads/{patientId}/{group}/{itemId} {
      allow read: if signedIn() && request.auth.uid == patientId;
      allow create: if signedIn() && request.auth.uid == patientId
        && (group == 'uploads' || group == 'items');
      allow update: if signedIn() && request.auth.uid == patientId && group == 'uploads'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /prescriptionUploads/{uploadId} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid
        || roleIs('pharmacist')
        || roleIs('clinician')
        || roleIs('platformAdmin')
      );
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.genericName is string
        && request.resource.data.genericName.size() > 0
        && request.resource.data.genericName.size() < 120;
      allow update, delete: if false;
    }
  }
}
